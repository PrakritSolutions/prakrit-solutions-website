# Absolute URL this deployment is served from — used for canonical URLs,
# Open Graph tags, and the sitemap. Leave unset in production (it falls
# back to https://prakritsolutions.in).
#
# On the draft/staging deployment, set this to the draft URL. Any value
# other than the production URL automatically enables the "work in
# progress" banner and blocks search indexing (see src/lib/site-config.ts).
NEXT_PUBLIC_SITE_URL=https://draft.prakritsolutions.in

# Optional: enables sending real contact-form emails via Resend once set.
# Without it, enquiries are still validated and logged server-side.
RESEND_API_KEY=

# Optional: enables Google Analytics (GA4) once set to a real Measurement ID
# (format: G-XXXXXXXXXX). Without it, the GA script never loads.
#
# Uses separate GA4 properties per environment so draft/QA traffic never
# mixes with real production numbers. Set this same key to a different
# value per Vercel environment (Settings -> Environment Variables):
#   Production -> the live site's Measurement ID
#   Preview    -> the draft site's Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Cloudflare Turnstile keeps bots off the contact form (dash.cloudflare.com -> Turnstile).
# The site key is public. The secret key stays server-side. On Vercel the form is
# refused (503) when the secret is missing, so set both in Production and Preview.
# For local testing use Cloudflare's published test pair:
#   site key  1x00000000000000000000AA  (always passes)
#   secret    1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis holds the per-IP, per-email and daily enquiry limits so they work across
# serverless instances. Add it from the Vercel Marketplace, which sets KV_REST_API_URL and
# KV_REST_API_TOKEN, or set the UPSTASH_REDIS_REST_* pair directly. Without it the form
# falls back to a weaker in-memory per-IP limit.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: appends each enquiry as a row in a private Google Sheet via an
# Apps Script web app. Setup steps: integrations/google-sheets/README.md.
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=
